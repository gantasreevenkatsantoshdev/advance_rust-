#[derive(Debug)]
struct Rectangle{
    hight:u16,
    width:u16,
}
//associative function
impl Rectangle{
    fn area (hight:u16,width:u16) -> Self{
        Self{
            hight,
            width,
        }
    }
    //methods
    fn area_rect(&self) -> u16{
        self.hight * self.width
    }
    fn change_width(&mut self){
        self.width = 225;
    }
}
fn main () {
    let  rect_one: Rectangle = Rectangle::area(200, 200);
    println!("rect_one:{:?}", rect_one);
    let mut rect_two: Rectangle = Rectangle::area(222, 200);
    println!("rect_two:{:?}", rect_two);

   let result_one= rect_one.area_rect();
    println!("result_on:{:?}", result_one);

    let result_two= rect_two.area_rect();
    println!("result_on:{:?}", result_two);

   let result_three= rect_two.change_width();
    println!("result_three:{:?}", rect_two);
}
