fn devide(x:i32, y:i32)->Result<i32,String>{
    if y==0{
        return Err("y is zero".to_string());
    }else {
        return Ok(x/y);
    }
}
fn main() {
    let result= devide(10,5);
    println!("{:?}",result);
}
